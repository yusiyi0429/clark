                  "type": "text",
                  "id": "aShCi",
                  "name": "Paragraph 2",
                  "fill": "$ink2",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "1.2 现金流影响：两期投入合计占用 Q4 现金流约 12%，仍在本年度安全线以内，未触发压缩条款。",
                  "lineHeight": 1.8,
                  "fontFamily": "$font",
                  "fontSize": 13,
                  "fontWeight": "normal"
                },
