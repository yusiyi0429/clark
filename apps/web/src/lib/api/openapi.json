                    "const": "red",
                    "type": "string"
                  }
                ]
              },
              "payload": {},
              "navigation": {
                "type": "array",
                "items": {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "href",
                    "label"
                  ],
                  "properties": {
                    "href": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    }
                  }
                }
              },
              "conversation": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "scope"
                ],
                "properties": {
                  "scope": {
                    "description": "对话范围：global 或对象类型:id",
                    "type": "string"
                  }
                }
              },
              "actions": {
                "type": "array",
                "items": {
