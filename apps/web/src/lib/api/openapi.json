                "title": {
                  "type": "string"
                },
                "badge": {
                  "type": "string"
                },
                "urgency": {
                  "anyOf": [
                    {
                      "const": "normal",
                      "type": "string"
                    },
                    {
                      "const": "red",
                      "type": "string"
                    }
                  ]
                },
                "payload": {},
                "navigation": {
                  "type": "array",
                  "items": {
                    "additionalProperties": false,
                    "type": "object",
                    "required": [
                      "href",
                      "label"
                    ],
                    "properties": {
                      "href": {
                        "type": "string"
