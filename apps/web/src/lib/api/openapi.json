                      "actionType": {
                        "type": "string"
                      },
                      "label": {
                        "type": "string"
                      },
                      "itemId": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "ActionDescriptor": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "actionId",
          "actionType",
          "label"
        ],
        "properties": {
          "actionId": {
            "description": "HMAC 签名的确定性动作令牌，Web 不解析",
            "type": "string"
          },
          "actionType": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "itemId": {
            "type": "string"
          }
        }
      },
      "ApiError": {
        "additionalProperties": false,
