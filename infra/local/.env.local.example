# 本地准生产 env 示例：只有变量名和假值。复制为 infra/local/.env.local（不入库）后填写。
# 完整变量说明见仓库根 .env.example；这里只列本地准生产需要的。

# ── 域名与入口 ──
# 443 被占用时改 LOCAL_HTTPS_PORT=8443，并写成 PUBLIC_DOMAIN=tk.local.test:8443
PUBLIC_DOMAIN=tk.local.test
LOCAL_HTTPS_PORT=443
EXTRA_ALLOWED_ORIGINS=

# ── 数据库与鉴权（本地自己生成随机值：openssl rand -base64 32） ──
POSTGRES_PASSWORD=change-me-local-pg
SESSION_SECRET=change-me-local-session-secret
DRI_SERVICE_TOKEN=change-me-local-dri
ONTOLOGY_SERVICE_TOKEN=

# ── 人员名单 ──
# 恢复线上备份时改成 /repo/seed/company-people.json（真实名单放到 seed/company-people.json，不入库）
COMPANY_PEOPLE_SEED=/repo/seed/company-people.example.json
COMPANY_NAME=

# ── 模型网关（必填；不想外呼时填一个不可达地址，如 http://127.0.0.1:9/v1） ──
PI_BASE_URL=https://model-gateway.example.com/v1
PI_API_KEY=fake-pi-key
LIGHT_MODEL=fake-light-model
HEAVY_MODEL=fake-heavy-model
COMPACTION_MODEL=fake-compaction-model

# ── 本体（只填测试 scope；留空则不读写本体） ──
TKOS_WORLD_API_URL=
TKOS_WORLD_AGENT_TOKEN=

# ── 可选外部服务（留空 = 如实显示未配置） ──
BOCHA_API_KEY=
WECHAT_MCP_TOKEN=
ARK_API_KEY=
DICTATION_POLISH_MODEL=
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
TOS_ENDPOINT=
TOS_REGION=
TOS_BUCKET=
VOLC_ASR_API_KEY=
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENT_ASR_APP_ID=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=warmap-local

# ── 构建源（国内网络慢时打开） ──
# NPM_CONFIG_REGISTRY=https://registry.npmmirror.com
# ALPINE_MIRROR=https://mirrors.aliyun.com
