# CEO WarMap 的站内入口（火山方案 B）。
# 宿主机 Nginx 终止 TLS，把整个域名转发到 127.0.0.1:3130（compose 映射到这里的 :80），不按路径拆；
# 这里只做站内分流：/api/*（含 SSE、multipart）与 /mcp/*（如 /mcp/me）直达 API，其余到 Web。
{
	servers {
		# 信任宿主机 Nginx（经 Docker 网桥进来，属私有网段）带来的 X-Forwarded-For/Proto，原样转给上游
		trusted_proxies static private_ranges
	}
}

# 部署换版本、重启时上游有几秒连不上：先等着、每 250ms 再连一次，20 秒内连上就照常转发，界面不报错。
# 只在没连上时重试（请求还没发出去），发消息这类 POST 重试也不会重复写入。
(retry_restart) {
	lb_try_duration 20s
	lb_try_interval 250ms
}

:80 {
	reverse_proxy /api/* api:4000 {
		flush_interval -1
		import retry_restart
	}
	reverse_proxy /mcp/* api:4000 {
		import retry_restart
	}
	reverse_proxy /.well-known/oauth-* api:4000 {
		import retry_restart
	}
	reverse_proxy /* web:3000 {
		import retry_restart
	}
}
