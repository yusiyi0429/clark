# CEO WarMap 环境变量示例。只列变量与说明，不包含真实值。
# Compose 部署时复制为 infra/.env；本地直跑 API 时复制为 apps/api/.env。

# ── Compose / edge ─────────────────────────────
# 公网域名（生产 mvp.tokenkingos.com）。edge 只绑 127.0.0.1:3130，TLS 由宿主机 Nginx 终止；
# 本地跑 Compose 时直接开 http://127.0.0.1:3130，并把它填进 EXTRA_ALLOWED_ORIGINS
PUBLIC_DOMAIN=localhost
# Compose 用 PUBLIC_DOMAIN 组成 https:// 域名；本地直跑 API 时自行填写浏览器访问来源（如 http://localhost:3100）。
PUBLIC_ORIGIN=http://localhost:3100
# PostgreSQL 密码（staging/production 不得复用其他环境值）
POSTGRES_PASSWORD=

# ── API 鉴权 ───────────────────────────────────
# 每人用「登录 ID + 4 位口令」登录；初始码由 `pnpm --filter @warmap/api access:issue` 发放（不走环境变量）。
# 随机长字符串：openssl rand -base64 32
SESSION_SECRET=
# 仅本地开发：除 PUBLIC_ORIGIN 外额外允许的浏览器来源，逗号分隔（如 http://127.0.0.1:3100,http://192.168.1.8:3100）。线上留空。
EXTRA_ALLOWED_ORIGINS=
# 登录多久没用才过期（用着就续期）：90 天
SESSION_MAX_AGE_SECONDS=7776000

# ── API 服务身份（与 CEO session 独立，互不可换） ──
DRI_SERVICE_TOKEN=
# 本体每周拉进展用的只读 token；不填则接口返回 503
ONTOLOGY_SERVICE_TOKEN=
# 独立 Chat 读确认会议的服务凭据；不填则 /internal/confirmed-meetings 一律 404
INTERNAL_CHAT_TOKEN=
# Nexus → DRI 确认的接收端（会上待定事项由 Nexus 推来、负责人本人确认后回调 Nexus）：凭据和租户都填才开，不填则接收接口一律 404
NEXUS_DRI_SERVICE_TOKEN=
NEXUS_DRI_TENANT_ID=
# 请求里 agentId 要等于它；不填是 tianshu-dri
NEXUS_DRI_AGENT_ID=
# 回调 Nexus 的地址和共享密钥（至少 32 字节）；不填就不发，确认记录留在待发，填上重启后补发
NEXUS_DRI_CALLBACK_URL=
NEXUS_DRI_CALLBACK_SECRET=
# 首页对话改走独立 Chat 服务（如预发 http://chat:3101，要同时填 INTERNAL_CHAT_TOKEN）；不填则走天枢自己的对话
CHAT_SERVICE_URL=
# 首页分段：设为 1 才开（首页的 Chat 对话闲置满 12 小时或跨过北京时间凌晨 4 点新开一段）；Chat 接上回看接口之前，上一段的纪要经 /internal/home-cards 的「以前的对话」卡交给 Chat
CHAT_SESSION_ROTATION=
# 天枢页面的对话分段（闲置满 12 小时或跨过凌晨 4 点换段，上一段经纪要交接）：设为 1 才开，缺省关时照旧闲置 12 小时重开；两个分段开关都关时不写会话纪要
CONVERSATION_SEGMENTS=

# ── 人员目录（缺失/不合规 seed → API 启动诚实失败；登录、角色、人名只看它） ──
# company-people.v1 人员名单 JSON：本地联调可指到 seed/company-people.example.json；
# 生产必须指向项目授权人提供的真实名单，禁止使用示例/演示人名
COMPANY_PEOPLE_SEED=../../seed/company-people.example.json
# 本月个人卡讨论候选目录；相对 API 运行目录解析，Compose 使用只读 seed 挂载。
MISSION_CARD_DRAFTS_DIR=../../seed/placeholders
# 已知的本月任务（飞书任务卡、本体 Mission 导出），起草任务卡时作为依据；只用月份一致的条目，文件缺失照常起草。
MISSION_CARD_KNOWN_MISSIONS_FILE=../../seed/imports/2026-10-known-missions.json
# 引导中的公司显示名，可空；留空时不猜测公司名。
COMPANY_NAME=
# 上手流程「授权天枢替你记进本体」这一步：本体的网页授权页确认后再设为 1
ONBOARDING_DELEGATION_STEP=

# ── 个人记忆与本体公司事实 ──────────────────────
# 本体公司事实的只读投影目录（写在 <目录>/company；个人记忆在数据库里）；不填用 /tmp 下的临时目录
MEMORY_STORAGE_DIR=
# 本体公司事实按人授权的域：JSON 文件 { "<personId>": ["<domain_id>", ...] }；不填时 query_company 一律如实回报「读不到」，不用本地资料兜底
# Compose 里写容器内路径（seed 只读挂载在 /repo/seed，如 /repo/seed/company-world-access.json）
COMPANY_WORLD_ACCESS_FILE=
# 后台服务（雷达、会前预审、预研、月度起草与复盘、任务卡起草）读本体公司事实时用谁的授权：填一个 personId，且它要在上面的授权文件里有域；不填时这些服务如实说没读到本体
COMPANY_SYSTEM_PERSON_ID=
# 本体（tkos.world）连接：地址与凭证；凭证也可放文件（TKOS_WORLD_AGENT_TOKEN_FILE，只读进内存）。都不填时本体相关能力如实显示未配置。
TKOS_WORLD_API_URL=
TKOS_WORLD_AGENT_TOKEN=
TKOS_WORLD_AGENT_TOKEN_FILE=
# 实例配置 mvp（缺省）/ demo / formal / tk，对应 apps/api/config/world-instance*.json；本地人员对应补充文件只合并 people
TKOS_WORLD_INSTANCE=
TKOS_WORLD_INSTANCE_LOCAL_FILE=
# 第二个只读实例（词元云集 TK scope）：只接受 tk；不填就关闭。地址缺省沿用 TKOS_WORLD_API_URL，凭证只从文件读
TKOS_WORLD_TK_INSTANCE=
TKOS_WORLD_TK_API_URL=
TKOS_WORLD_TK_TOKEN_FILE=
# 签发月度计划后代记本体周期目标的门（代 RU DRI 承诺、代 CEO 确认；代谁见实例配置 unit_dris）：本人委托登记好后再设为 1；只管这一项，会议、周复盘等写入照常
TKOS_WORLD_PERIOD_GOAL_GATES=

# ── Pi Conversation（OpenAI-compatible Responses） ──
# PI_BASE_URL 可写到 /v1 或 /v1/responses，API 会统一规范化
PI_BASE_URL=
PI_API_KEY=
LIGHT_MODEL=
# 唯一预研深度使用的 heavy 槽位（必须显式配置，不回退到 light）
HEAVY_MODEL=
COMPACTION_MODEL=
# 个人记忆召回：每轮从本人的记忆目录里挑相关条目的快模型，与分诊分开配；不配时依次用 TRIAGE_MODEL、LIGHT_MODEL。
# 推荐 deepseek-v4.1-flash（.scratch/memory-recall/结论.md：300 条记忆召回 0.96，P90 约 1.7 秒）
MEMORY_RECALL_MODEL=deepseek-v4.1-flash
# 一号位对话主答与分诊（可选）：不配时主答用 HEAVY_MODEL、分诊用 LIGHT_MODEL；协议与地址按模型 id 推断，可用 CONVERSATION_API / CONVERSATION_BASE_URL 覆盖
CONVERSATION_MODEL=
CONVERSATION_API=
CONVERSATION_BASE_URL=
CONVERSATION_THINKING=
TRIAGE_MODEL=
# 各候选 Agent 的模型与思考强度（可选，apps/api/src/agentModels.ts）；思考取 off/minimal/low/medium/high/xhigh，写错启动失败
# 会前预审缺省 HEAVY_MODEL·high；预研、会后提取缺省 HEAVY_MODEL；公司雷达缺省 LIGHT_MODEL；个人雷达缺省跟公司雷达；记忆导入缺省 LIGHT_MODEL；战场进展汇总缺省 HEAVY_MODEL·medium
PREFLIGHT_MODEL=
PREFLIGHT_THINKING=
RESEARCH_MODEL=
RESEARCH_THINKING=
OUTCOME_MODEL=
OUTCOME_THINKING=
RADAR_MODEL=
RADAR_THINKING=
PERSONAL_RADAR_MODEL=
PERSONAL_RADAR_THINKING=
MEMORY_IMPORT_MODEL=
MEMORY_IMPORT_THINKING=
PROGRESS_SUMMARY_MODEL=
PROGRESS_SUMMARY_THINKING=
TASK_PLACEMENT_MODEL=
TASK_PLACEMENT_THINKING=
# 会话纪要（后台，一段闲置 15 分钟后增量写）：缺省 LIGHT_MODEL、不开思考；设计上用 TokenHub 上的 qwen 快模型
CONVERSATION_DIGEST_MODEL=
CONVERSATION_DIGEST_THINKING=
# 交付物评审与版本说明（指向 TokenHub，要能看图的重模型）：不配时用 PI_BASE_URL / PI_API_KEY / HEAVY_MODEL、思考 medium
REVIEW_MODEL=
REVIEW_BASE_URL=
REVIEW_API_KEY=
REVIEW_THINKING=
# 云端拆卡和云端 Agent 验收：缺省关（拆卡、验收在本人电脑上由规划员、验收员做）；设 1 打开（用上面的 REVIEW_* 模型）
BOARD_CLOUD_AGENTS=

# ── Radar ─────────────────────────────────────
# scheduled/manual 共用同一管线；scheduled 由企业日键每日最多启动一次（不依赖外部 cron）
# 唯一 Web Search Provider 是博查（Ticket 16 决策，已删除 Brave/SEARCH_API_KEY）：
# https://open.bochaai.com 申请 key；缺失时 Radar Card 如实显示未配置，不冒充已配置
BOCHA_API_KEY=
# 公众号账号级来源：独立 AGPL sidecar tmwgsicp/wechat-download-api 的 MCP（内网，不经 Caddy）。
# WarMap 只持有 sidecar 的静态 Token，从不接触微信 Cookie；扫码登录在 sidecar 自己的登录页完成。
# WECHAT_MCP_URL 指向 Compose 内网地址（如 http://wechat:5000/mcp）；WECHAT_MCP_TOKEN 与 sidecar MCP_TOKEN 一致
WECHAT_MCP_URL=
WECHAT_MCP_TOKEN=
# sidecar 自报的站点地址（用于它自己的图片代理链接）；默认仅在宿主机/容器内使用
WECHAT_SITE_URL=http://localhost:5000
# 仅首次扫码登录用的临时宿主端口（infra/staging/wechat-login.override.yml，只绑 127.0.0.1）
WECHAT_LOGIN_PORT=15000
# 可选：sidecar 抓取用 SOCKS5 代理池（多个逗号分隔），降低微信风控；留空则直连
# 例：socks5://host.docker.internal:1080（macOS/Windows 本机代理）
WECHAT_PROXY_URLS=

# ── 会议录音转写 / 本人声纹 ─────────────────────
# TOS 五项必须配全才能上传录音；缺任一项时转写无法开始，错误会指出缺少的变量。
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
TOS_ENDPOINT=
TOS_REGION=
TOS_BUCKET=
# 火山录音识别：新版填 API Key；旧版则同时填写 APP ID 与 Access Token。两种都缺时不能转写。
VOLC_ASR_API_KEY=
VOLC_ASR_APP_KEY=
VOLC_ASR_ACCESS_KEY=
# 可选，默认 volc.seedasr.auc；提交与查询使用同一个资源 ID。
VOLC_ASR_RESOURCE_ID=
# 本人声纹需腾讯云两项密钥；缺少时声纹录入与比对不可用。
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
# 可选，默认 ap-shanghai / tianshu；声纹分组只能含英文字母与下划线。
TENCENT_ASR_REGION=
TENCENT_VOICEPRINT_GROUP=
# 输入框实时语音转文字：服务端用上面两项腾讯云密钥签短时地址，浏览器直连腾讯实时识别；另需语音识别 AppID（纯数字）。
# 缺少时自动退回「说完再转」（走上面的火山录音识别）。建议用只授权了语音识别的子账号密钥。
TENCENT_ASR_APP_ID=
# 可选，默认 16k_zh_en_2.0。
TENCENT_ASR_ENGINE=
# 听写后的快速整理（火山方舟，OpenAI 兼容接口）；缺 ARK_API_KEY 或 DICTATION_POLISH_MODEL 时保留识别原文、不整理。
ARK_API_KEY=
# 可选，默认 https://ark.cn-beijing.volces.com/api/v3
ARK_BASE_URL=
DICTATION_POLISH_MODEL=
# 可选：同时发出的备用模型（逐句取先回来的，整段优先主模型）；逐句硬超时毫秒数，默认 1200。
DICTATION_POLISH_BACKUP_MODEL=
DICTATION_POLISH_TIMEOUT_MS=
# 录音分片与转码文件目录；Compose 固定为持久卷，本地直跑可留空使用 API 默认目录。
MEETING_RECORDING_STORAGE_DIR=
# 会前材料与对话附件目录：同上，Compose 固定为持久卷，只在本地直跑时使用。
MEETING_MATERIAL_STORAGE_DIR=
CONVERSATION_ATTACHMENT_STORAGE_DIR=
# 可选，默认从 PATH 查找 ffmpeg；缺少可执行文件时录音转码与声纹采样会失败。
FFMPEG_PATH=

# ── 飞书企业自建应用（前三项都不填＝关闭飞书接入；只填一部分启动失败） ──
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 用户令牌加密密钥：base64 的 32 字节（openssl rand -base64 32），与 SESSION_SECRET 分开，各环境不得复用
FEISHU_TOKEN_KEY=
# 当前密钥版本，换密钥时递增（缺省 1）
FEISHU_TOKEN_KEY_VERSION=1
# 采集表写入：live 才写真实多维表格，其余（含留空）为 mock
FEISHU_BITABLE_MODE=
# 飞书网页域名（如 https://tokenking.feishu.cn）：会议事件写本体时拼妙记链接；留空不带链接
FEISHU_WEB_ORIGIN=
# 信息收集、文档变更推送：1 才开，其余（含 0）关
COLLECTIONS_ENABLED=0
DOC_CHANGE_ENABLED=0
# 管理员视图：逗号分隔的 personId；留空时没有人能看
TIANSHU_ADMIN_PERSON_IDS=

# ── 可选观测（缺失时完全 no-op，不影响业务） ──
# 只有 LANGSMITH_TRACING=true 且有 LANGSMITH_API_KEY 才上报（apps/api/src/tracing.ts）；凭据字段会被过滤，业务与记忆正文照常记录
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=warmap
LANGSMITH_TRACING=
# 可选：自建或区域端点
LANGSMITH_ENDPOINT=
# 匿名用户 id 的盐；不填时本地生成 .data/trace-anon-salt
TRACE_ANON_SALT=

# ── 其他 ───────────────────────────────────────
BUILD_SHA=dev

# ── 宿主机备份（infra/backup/backup.sh；API 镜像不含备份工具） ──
# 备份源模式：compose（默认）＝ PostgreSQL 只在 Compose 内网，经 docker compose exec 在容器内
# pg_dump/psql；url ＝ 外部库，需 DATABASE_URL 与宿主机 pg_dump/psql（如 libpq keg-only）
BACKUP_SOURCE_MODE=compose
# 仅 BACKUP_SOURCE_MODE=url 使用；不进入 API 容器
DATABASE_URL=
# 可选覆盖（默认由脚本按仓库根推导）：compose 文件/env 文件/服务名/库名/用户
# WARMAP_COMPOSE_FILE=
# WARMAP_ENV_FILE=
# WARMAP_PG_SERVICE=postgres
# WARMAP_DB_NAME=warmap
# WARMAP_DB_USER=warmap
# age 公钥（age1...）与私钥文件路径：私钥只放宿主机受限位置，绝不进仓库/镜像
BACKUP_AGE_RECIPIENT=
BACKUP_AGE_IDENTITY=
# 异机目标（SSH/SFTP）：私钥路径同样只放宿主机
BACKUP_SSH_HOST=
BACKUP_SSH_USER=
BACKUP_SSH_PATH=
BACKUP_SSH_KEY_PATH=
# 异机与本机保留天数（至少 7 天）
BACKUP_RETENTION_DAYS=7
