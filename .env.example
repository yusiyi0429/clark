# CEO WarMap 环境变量示例。只列变量与说明，不包含真实值。
# Compose 部署时复制为 infra/.env；本地直跑 API 时复制为 apps/api/.env。

# ── Compose / edge ─────────────────────────────
# 公网域名（生产 mvp.tokenkingos.com）。edge 只绑 127.0.0.1:3130，TLS 由宿主机 Nginx 终止；
# 本地跑 Compose 时直接开 http://127.0.0.1:3130，并把它填进 EXTRA_ALLOWED_ORIGINS
PUBLIC_DOMAIN=localhost
# Compose 用 PUBLIC_DOMAIN 组成 https:// 域名；本地直跑 API 时自行填写浏览器访问来源（如 http://localhost:3100）。
PUBLIC_ORIGIN=http://localhost:3100
# PostgreSQL 密码（staging/production 不得复用其他环境值）
POSTGRES_PASSWORD=

# ── API 鉴权 ───────────────────────────────────
# 每人用「登录 ID + 4 位口令」登录；初始码由 `pnpm --filter @warmap/api access:issue` 发放（不走环境变量）。
# 随机长字符串：openssl rand -base64 32
SESSION_SECRET=
# 仅本地开发：除 PUBLIC_ORIGIN 外额外允许的浏览器来源，逗号分隔（如 http://127.0.0.1:3100,http://192.168.1.8:3100）。线上留空。
EXTRA_ALLOWED_ORIGINS=
# 登录记住 30 天
SESSION_MAX_AGE_SECONDS=2592000

# ── API 服务身份（与 CEO session 独立，互不可换） ──
DRI_SERVICE_TOKEN=
# 本体每周拉进展用的只读 token；不填则接口返回 503
ONTOLOGY_SERVICE_TOKEN=
COMPANY_MEMORY_MCP_TOKEN=

# ── CompanyMemory MCP（缺失/不合规 seed → API 启动诚实失败） ──
# Markdown 认知章节目录：单一来源为 seed/memory/CompanyMemory.md 所在目录（相对 apps/api 运行目录）；
# Compose 只读挂载后由容器内绝对路径覆盖
COMPANY_MEMORY_SEED_DIR=../../seed/memory
# company-people.v1 人员名单 JSON：本地联调可指到 seed/company-people.example.json；
# 生产必须指向项目授权人提供的真实名单，禁止使用示例/演示人名
COMPANY_PEOPLE_SEED=../../seed/company-people.example.json
# 本月个人卡讨论候选目录；相对 API 运行目录解析，Compose 使用只读 seed 挂载。
MISSION_CARD_DRAFTS_DIR=../../seed/placeholders
# 已知的本月任务（飞书任务卡、本体 Mission 导出），起草任务卡时作为依据；只用月份一致的条目，文件缺失照常起草。
MISSION_CARD_KNOWN_MISSIONS_FILE=../../seed/imports/2026-10-known-missions.json
# 引导中的公司显示名，可空；留空时不猜测公司名。
COMPANY_NAME=

# ── Pi Conversation（OpenAI-compatible Responses） ──
# PI_BASE_URL 可写到 /v1 或 /v1/responses，API 会统一规范化
PI_BASE_URL=
PI_API_KEY=
LIGHT_MODEL=
# 唯一预研深度使用的 heavy 槽位（必须显式配置，不回退到 light）
HEAVY_MODEL=
COMPACTION_MODEL=

# ── Radar ─────────────────────────────────────
# scheduled/manual 共用同一管线；scheduled 由企业日键每日最多启动一次（不依赖外部 cron）
# 唯一 Web Search Provider 是博查（Ticket 16 决策，已删除 Brave/SEARCH_API_KEY）：
# https://open.bochaai.com 申请 key；缺失时 Radar Card 如实显示未配置，不冒充已配置
BOCHA_API_KEY=
# 公众号账号级来源：独立 AGPL sidecar tmwgsicp/wechat-download-api 的 MCP（内网，不经 Caddy）。
# WarMap 只持有 sidecar 的静态 Token，从不接触微信 Cookie；扫码登录在 sidecar 自己的登录页完成。
# WECHAT_MCP_URL 指向 Compose 内网地址（如 http://wechat:5000/mcp）；WECHAT_MCP_TOKEN 与 sidecar MCP_TOKEN 一致
WECHAT_MCP_URL=
WECHAT_MCP_TOKEN=
# sidecar 自报的站点地址（用于它自己的图片代理链接）；默认仅在宿主机/容器内使用
WECHAT_SITE_URL=http://localhost:5000
# 仅首次扫码登录用的临时宿主端口（infra/staging/wechat-login.override.yml，只绑 127.0.0.1）
WECHAT_LOGIN_PORT=15000
# 可选：sidecar 抓取用 SOCKS5 代理池（多个逗号分隔），降低微信风控；留空则直连
# 例：socks5://host.docker.internal:1080（macOS/Windows 本机代理）
WECHAT_PROXY_URLS=

# ── 会议录音转写 / 本人声纹 ─────────────────────
# TOS 五项必须配全才能上传录音；缺任一项时转写无法开始，错误会指出缺少的变量。
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
TOS_ENDPOINT=
TOS_REGION=
TOS_BUCKET=
# 火山录音识别：新版填 API Key；旧版则同时填写 APP ID 与 Access Token。两种都缺时不能转写。
VOLC_ASR_API_KEY=
VOLC_ASR_APP_KEY=
VOLC_ASR_ACCESS_KEY=
# 可选，默认 volc.seedasr.auc；提交与查询使用同一个资源 ID。
VOLC_ASR_RESOURCE_ID=
# 本人声纹需腾讯云两项密钥；缺少时声纹录入与比对不可用。
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
# 可选，默认 ap-shanghai / tianshu；声纹分组只能含英文字母与下划线。
TENCENT_ASR_REGION=
TENCENT_VOICEPRINT_GROUP=
# 录音分片与转码文件目录；Compose 固定为持久卷，本地直跑可留空使用 API 默认目录。
MEETING_RECORDING_STORAGE_DIR=
# 可选，默认从 PATH 查找 ffmpeg；缺少可执行文件时录音转码与声纹采样会失败。
FFMPEG_PATH=

# ── 可选观测（缺失时完全 no-op，不影响业务） ──
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=warmap

# ── 其他 ───────────────────────────────────────
BUILD_SHA=dev
COMPANY_TIMEZONE=Asia/Shanghai

# ── 宿主机备份（infra/backup/backup.sh；API 镜像不含备份工具） ──
# 备份源模式：compose（默认）＝ PostgreSQL 只在 Compose 内网，经 docker compose exec 在容器内
# pg_dump/psql；url ＝ 外部库，需 DATABASE_URL 与宿主机 pg_dump/psql（如 libpq keg-only）
BACKUP_SOURCE_MODE=compose
# 仅 BACKUP_SOURCE_MODE=url 使用；不进入 API 容器
DATABASE_URL=
# 可选覆盖（默认由脚本按仓库根推导）：compose 文件/env 文件/服务名/库名/用户
# WARMAP_COMPOSE_FILE=
# WARMAP_ENV_FILE=
# WARMAP_PG_SERVICE=postgres
# WARMAP_DB_NAME=warmap
# WARMAP_DB_USER=warmap
# age 公钥（age1...）与私钥文件路径：私钥只放宿主机受限位置，绝不进仓库/镜像
BACKUP_AGE_RECIPIENT=
BACKUP_AGE_IDENTITY=
# 异机目标（SSH/SFTP）：私钥路径同样只放宿主机
BACKUP_SSH_HOST=
BACKUP_SSH_USER=
BACKUP_SSH_PATH=
BACKUP_SSH_KEY_PATH=
# 异机与本机保留天数（至少 7 天）
BACKUP_RETENTION_DAYS=7

# Company 公司事实只读：显式人员可见 World domain；无许可时拒绝公司事实读取。
# 文件内容：{"person-id":["authorized-domain-id"]}，挂载只读。服务 Token 不等于人员授权。
COMPANY_WORLD_ACCESS_FILE=
# 可重建的 Company 生成投影卷（生产请挂载持久目录，0700，仅 API 可写）
COMPANY_STORAGE_DIR=/tmp/warmap-company
