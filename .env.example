# 天枢统一配置。复制为仓库根目录 .env，权限设为 600。
# 配置规则见 docs/guides/environment.md。不得填写或提交真实凭据。
# Node 与 Compose 都优先使用进程环境；值使用字面量，不引用其他变量。

# 本地 API；pnpm 在 apps/api 运行，相对文件路径从该目录解析。
DATABASE_URL=postgres://postgres:local-only-change-me@127.0.0.1:55432/tianshu_local
PORT=4000
PUBLIC_ORIGIN=http://localhost:3100
EXTRA_ALLOWED_ORIGINS=http://127.0.0.1:3100
SESSION_SECRET=
SESSION_MAX_AGE_SECONDS=2592000
DRI_SERVICE_TOKEN=
ONTOLOGY_SERVICE_TOKEN=
BUILD_SHA=dev

# Web 只读取这两个开发代理地址。端口使用 next dev --port 设置。
API_SERVER_URL=http://localhost:4000
M2_SERVER_URL=http://localhost:4333

# 人员与任务卡；生产必须使用真实授权名单及容器内路径。
COMPANY_PEOPLE_SEED=../../seed/company-people.example.json
COMPANY_NAME=
MISSION_CARD_DRAFTS_DIR=../../seed/placeholders
MISSION_CARD_KNOWN_MISSIONS_FILE=../../seed/imports/2026-10-known-missions.json

# World 只读连接；服务令牌不代替每人的 domain 授权。
TKOS_WORLD_API_URL=
TKOS_WORLD_AGENT_TOKEN=
COMPANY_WORLD_ACCESS_FILE=
COMPANY_SYSTEM_PERSON_ID=
MEMORY_STORAGE_DIR=../../.data/memory
MEETING_MATERIAL_STORAGE_DIR=../../.data/materials
CONVERSATION_ATTACHMENT_STORAGE_DIR=../../.data/attachments
MEETING_RECORDING_STORAGE_DIR=../../.data/recordings

# API 模型使用 OpenAI-compatible Responses，三个槽位均须填写。
PI_BASE_URL=
PI_API_KEY=
LIGHT_MODEL=
HEAVY_MODEL=
COMPACTION_MODEL=

# LangSmith 会接收完整业务、Company/Personal 正文与蒸馏内容。
# 凭据不得进入追踪。缺少 key 或设置 false 时不上传。
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=Tianshu_Oct
LANGSMITH_TRACING=true
LANGSMITH_IDENTITY_SALT=

# 雷达：博查搜索与公众号 MCP。缺少配置时相关来源不可用。
BOCHA_API_KEY=
WECHAT_MCP_URL=
WECHAT_MCP_TOKEN=
WECHAT_SITE_URL=http://localhost:5000
WECHAT_LOGIN_PORT=15000
WECHAT_PROXY_URLS=

# 录音：TOS、火山 ASR、腾讯声纹。留空时对应能力不可用。
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
TOS_ENDPOINT=
TOS_REGION=
TOS_BUCKET=
VOLC_ASR_API_KEY=
VOLC_ASR_APP_KEY=
VOLC_ASR_ACCESS_KEY=
VOLC_ASR_RESOURCE_ID=
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENT_ASR_REGION=
TENCENT_VOICEPRINT_GROUP=
FFMPEG_PATH=

# Compose 只向各服务传递声明过的变量；不得整份 env_file 注入 Web。
# 每台主机各自维护根目录 .env，本地配置不能原样部署。
PUBLIC_DOMAIN=localhost
POSTGRES_PASSWORD=
NPM_CONFIG_REGISTRY=https://registry.npmjs.org/
ALPINE_MIRROR=

# 宿主机备份；脚本启动前导出本节变量。默认异机备份。
BACKUP_SOURCE_MODE=compose
BACKUP_TARGET=ssh
BACKUP_AGE_RECIPIENT=
BACKUP_AGE_IDENTITY=
BACKUP_SSH_HOST=
BACKUP_SSH_USER=
BACKUP_SSH_PATH=
BACKUP_SSH_KEY_PATH=
BACKUP_RETENTION_DAYS=7
# BACKUP_LOCAL_DIR=/absolute/path/to/backups
# WARMAP_COMPOSE_FILE=/absolute/path/to/infra/docker-compose.yml
# WARMAP_COMPOSE_OVERRIDE=/absolute/path/to/infra/volcano.override.yml
# WARMAP_ENV_FILE=/absolute/path/to/.env

# 可选 M2 本地服务。独立端口避免使用 API 的 PORT。
M2_PORT=4333
M2_BIND_HOST=127.0.0.1
M2_AUTH_API_URL=http://127.0.0.1:4000/api/auth/session
M2_SEED_DIR=../../seed/m2
M2_ACCOUNT_MAP_FILE=../../seed/m2/accounts.json
M2_INTERNAL_TOKEN=
DECODING_API_BASE=http://115.191.26.230:8000/api/openai/v1
DECODING_API_KEY=
DECODING_MODEL=wangsu/gpt-6.1-sol
DECODING_DISABLE_LOCAL_KEY=1
TKOS_WORLD_PRODUCT_TOKEN=
# M2_ONTOLOGY_MANIFEST_FILE=/absolute/path/to/ontology-selection.json
# DECODING_STATE_PATH=/absolute/path/to/collaboration.json
# DECODING_RUNS_DIR=/absolute/path/to/runs
# DECODING_SKILL_DIR=/absolute/path/to/skill
# DECODING_ROUND_CONCURRENCY=40
# DECODING_API_KEY_FILE=/absolute/path/to/model-key

# M2 Compose 使用现有部署变量名，映射到容器的 DECODING_*。
# 启用 infra/m2.override.yml 时必须填写；M2_SEED_DIR 使用宿主机绝对路径。
M2_MODEL_BASE=http://115.191.26.230:8000/api/openai/v1
M2_MODEL_KEY=
M2_MODEL=wangsu/gpt-6.1-sol
M2_WORLD_READ_TOKEN=
