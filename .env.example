# CEO WarMap 环境变量示例。只列变量与说明，不包含真实值。
# Compose 部署时复制为 infra/.env；本地直跑 API 时复制为 apps/api/.env。

# ── Compose / edge ─────────────────────────────
# 公网域名，本地联调用 localhost（Caddy 自签证书）
PUBLIC_DOMAIN=localhost
# PostgreSQL 密码（staging/production 不得复用其他环境值）
POSTGRES_PASSWORD=

# ── API 鉴权 ───────────────────────────────────
# node apps/api/scripts/hash-password.mjs "<CEO 密码>" 生成
CEO_ACCESS_PASSWORD_HASH=
# 随机长字符串：openssl rand -base64 32
SESSION_SECRET=
SESSION_MAX_AGE_SECONDS=28800

# ── API 服务身份（与 CEO session 独立，互不可换） ──
DRI_SERVICE_TOKEN=
COMPANY_MEMORY_MCP_TOKEN=

# ── 其他 ───────────────────────────────────────
BUILD_SHA=dev
COMPANY_TIMEZONE=Asia/Shanghai
