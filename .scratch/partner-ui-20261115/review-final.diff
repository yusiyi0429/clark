+.receipts li { display: flex; gap: var(--space-2) var(--space-3); flex-wrap: wrap; align-items: center; padding-block: var(--space-2); }
+.receipts li + li { border-block-start: 1px solid var(--hairline); }
+.receiptBody { display: grid; gap: var(--space-1); min-width: 0; flex: 1 1 12rem; font-size: var(--text-sm); line-height: 1.6; }
+.receipts li > a, .receipts li > button { flex-shrink: 0; }
+.receipts li > a { padding-inline: var(--space-2); }
+.picker fieldset { display: grid; gap: var(--space-2); border: 1px solid var(--hairline); border-radius: var(--r-control); min-width: 0; margin: 0; padding: var(--space-3); }
+.picker legend { font-size: var(--text-sm); }
+.choice { display: flex; align-items: center; gap: var(--space-2); min-height: 44px; cursor: pointer; line-height: 1.6; }
+.choice input { flex-shrink: 0; }
 .note { display: grid; gap: var(--space-1); margin-block: var(--space-1); }
-.note textarea { font: inherit; color: var(--ink); background: transparent; border: 1px solid var(--hairline-strong); border-radius: var(--r-control); padding: var(--space-1); resize: none; }
-.actions button, .entry button, .panel button { cursor: pointer; justify-self: start; width: fit-content; color: var(--ink); background: transparent; border: 1px solid var(--hairline-strong); border-radius: var(--r-control); padding: 4px 10px; font: inherit; }
+.note textarea { box-sizing: border-box; min-width: 0; width: 100%; min-height: 88px; font: inherit; color: var(--ink); background: var(--surface); border: 1px solid var(--hairline-strong); border-radius: var(--r-control); padding: var(--space-2); resize: vertical; }
+.actions button, .entry button, .notice button { cursor: pointer; justify-self: start; width: fit-content; color: var(--ink); background: transparent; border: 1px solid var(--hairline-strong); border-radius: var(--r-control); padding: var(--space-2) var(--space-3); font: inherit; line-height: 1.5; }
+.actions button.primary, .entry button.primary { background: var(--solid); color: var(--solid-fg); border-color: var(--solid); }
 .actions button:disabled, .entry button:disabled { opacity: .55; cursor: default; }
-.actions button:focus-visible, .entry button:focus-visible, .source summary:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
+.notice { display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap; color: var(--counter); overflow-wrap: anywhere; }
+.actions button:focus-visible, .entry:focus-visible, .entry button:focus-visible, .entry summary:focus-visible, .entry a:focus-visible, .note textarea:focus-visible, .notice button:focus-visible { outline: 2px solid var(--focus, var(--ring)); outline-offset: 3px; }
+@media (max-width: 400px) {
+  .entry { padding: var(--space-3); }
+  .receiptBody { flex-basis: 100%; }
+  .picker fieldset { padding: var(--space-2); }
+}
