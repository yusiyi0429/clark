{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "CEO WarMap · 六实体生命周期",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "viewBox": [980, 630]
  },
  "lanes": [
    { "id": "main", "label": "Signal → Issue → Meeting → Outcome" },
    { "id": "plan", "label": "MonthlyPlan" },
    { "id": "conversation", "label": "Conversation" },
    { "id": "terminal", "label": "Dismissed / Cancelled" }
  ],
  "states": [
    { "id": "signal", "type": "start", "label": "Signal", "sublabel": "collected → assessed", "lane": "main", "col": 0, "step": "01" },
    { "id": "issue", "type": "decision", "label": "Issue", "sublabel": "pending + research", "lane": "main", "col": 1, "step": "02" },
    { "id": "meeting", "type": "active", "label": "Meeting", "sublabel": "optional · scheduled → held", "lane": "main", "col": 2, "step": "03" },
    { "id": "outcome", "type": "decision", "label": "MeetingOutcome", "sublabel": "draft → reviewing", "lane": "main", "col": 3, "step": "04" },
    { "id": "organizationFact", "type": "success", "label": "Confirmed", "sublabel": "decided / reviewed", "lane": "main", "col": 4, "step": "05" },

    { "id": "planDraft", "type": "start", "label": "MonthlyPlan Draft", "sublabel": "每月 1 日", "lane": "plan", "col": 0, "yOffset": -38, "width": 118 },
    { "id": "planNegotiating", "type": "active", "label": "Negotiating", "sublabel": "CEO 编辑 + DRI 反馈", "lane": "plan", "col": 1, "yOffset": -38, "width": 118 },
    { "id": "planConfirmed", "type": "success", "label": "Plan Confirmed", "sublabel": "CEO 签发", "lane": "plan", "col": 2, "yOffset": -38, "width": 118 },

    { "id": "conversationCreated", "type": "start", "label": "Conversation", "sublabel": "scope 独立创建", "lane": "conversation", "col": 0, "yOffset": 42, "width": 118 },
    { "id": "conversationActive", "type": "active", "label": "Messages Appended", "sublabel": "PostgreSQL 原文", "lane": "conversation", "col": 1, "yOffset": 42, "width": 118 },
    { "id": "conversationCompacted", "type": "active", "label": "Pi Compacted", "sublabel": "entries 可恢复", "lane": "conversation", "col": 2, "yOffset": 42, "width": 118 },

    { "id": "issueDismissed", "type": "neutral", "label": "Issue Dismissed", "sublabel": "移出议题", "lane": "terminal", "col": 0 },
    { "id": "meetingCancelled", "type": "failure", "label": "Meeting Cancelled", "sublabel": "仅 scheduled", "lane": "terminal", "col": 2 }
  ],
  "transitions": [
    { "id": "signalToIssue", "from": "signal", "to": "issue", "variant": "emphasis", "route": "straight" },
    { "id": "issueToMeeting", "from": "issue", "to": "meeting", "route": "straight" },
    { "id": "meetingToOutcome", "from": "meeting", "to": "outcome", "route": "straight" },
    { "id": "outcomeToFact", "from": "outcome", "to": "organizationFact", "variant": "emphasis", "route": "straight" },

    { "id": "planToNegotiating", "from": "planDraft", "to": "planNegotiating", "route": "straight" },
    { "id": "planToConfirmed", "from": "planNegotiating", "to": "planConfirmed", "variant": "emphasis", "route": "straight" },

    { "id": "conversationToActive", "from": "conversationCreated", "to": "conversationActive", "route": "straight" },
    { "id": "conversationToCompacted", "from": "conversationActive", "to": "conversationCompacted", "route": "straight" },

    { "id": "issueToDismissed", "from": "issue", "to": "issueDismissed", "variant": "dashed", "fromSide": "bottom", "toSide": "top", "via": [[248, 210], [248, 420], [402, 420]] },
    { "id": "meetingToCancelled", "from": "meeting", "to": "meetingCancelled", "variant": "security", "fromSide": "top", "toSide": "top", "via": [[402, 90], [820, 90], [820, 420], [710, 420]] }
  ]
}
