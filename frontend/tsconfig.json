{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-agenda/types/**/*.ts",
    ".next-agenda/dev/types/**/*.ts",
    ".next-build/types/**/*.ts",
    ".next-build/dev/types/**/*.ts",
    ".next-demo/types/**/*.ts",
    ".next-demo/dev/types/**/*.ts",
    ".next-recordings/types/**/*.ts",
    ".next-recordings/dev/types/**/*.ts",
    ".next-wstest/types/**/*.ts",
    ".next-wstest/dev/types/**/*.ts",
    ".next-merge/types/**/*.ts",
    ".next-merge/dev/types/**/*.ts",
    ".next-readonly/types/**/*.ts",
    ".next-readonly/dev/types/**/*.ts",
    ".next-rail/types/**/*.ts",
    ".next-rail/dev/types/**/*.ts",
    ".next-panel/types/**/*.ts",
    ".next-panel/dev/types/**/*.ts",
    ".next-logout/types/**/*.ts",
    ".next-logout/dev/types/**/*.ts",
    ".next-writer-alt/types/**/*.ts",
    ".next-writer-alt/dev/types/**/*.ts",
    ".next-synth/types/**/*.ts",
    ".next-synth/dev/types/**/*.ts",
    ".next-checkb/types/**/*.ts",
    ".next-checkb/dev/types/**/*.ts",
    ".next-cheap/types/**/*.ts",
    ".next-cheap/dev/types/**/*.ts",
    ".next-share-preview/types/**/*.ts",
    ".next-share-preview/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next-agenda",
    ".next-build",
    ".next-demo",
    ".next-merge",
    ".next-wstest"
  ]
}
