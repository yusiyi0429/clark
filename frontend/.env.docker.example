# 本机容器验证用。复制成 .env.docker 后填真值。
#   cp .env.docker.example .env.docker
#   docker compose --env-file .env.docker up -d --build
#
# .gitignore 已忽略 .env*，真密钥不会进仓库。
# 火山云上不用这个文件——密钥走平台的密钥管理注入。

TAG=dev
TKOS_CODE_SHA=dev
PORT=3000

# 构建镜像源（境外网络改成 https://registry.npmjs.org）
NPM_REGISTRY=https://registry.npmmirror.com

# ── 本体 Runtime API（外部依赖，由 Ontology 域部署）──
TKOS_ONTOLOGY_BASE_URL=http://115.190.213.44:8000
TKOS_API_KEY=

# ── 模型槽位（按角色配，不按厂商配；定义见 src/lib/models/{registry,slots}.ts）──
#
# 五个槽位、两把 key。火山方舟本身是多模型网关，DeepSeek 那两个和豆包一个 key 全能
# 拿到；深研另外两条链路在 Bedrock 上，也共用一把（各一段在下面）。
#
#   PRO    主对话与高质量生成（A6 回复、A2 定题、A4 深研、A10 写回）
#   FLASH  高频轻任务（A1a 产卡、关系标注这类三选一分类）
#   ALT    深研第二条链路（屏幕上那一栏叫「Claude」），也用于交叉 judge
#   SYNTH  深研第三条链路，也是判断板的主源（屏幕上叫「ChatGPT」）
#   SEED   深研第四条链路（屏幕上叫「豆包」）。走方舟，**和 PRO 同一把 key** —— 配了
#          ARK_API_KEY 就有这一栏，不用填任何新变量
#
# ★ 深研那几条必须互不同家族。理由不是「要用不同厂商」，是自己判自己会通过自己的失败
#   模式 —— 退化成同家族时校验等于没做，通过率反而更好看。配错了启动日志会告警
#   （只告警不阻断）。
# 方舟这边只剩模型广场一个出口（ARK_API_KEY + /api/v3），出 pro / flash / seed。套餐那个
# 出口（ARK_AGENT_API_KEY + /api/plan/v3）2026-08-25 起没有模型走它，两个变量一起删了：
# 配着却没有任何代码去读的 key 是个陷阱。
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 模型 id 覆盖，不填就用注册表默认值。老名字 ARK_MODEL_PRO / _FLASH / _ALT 已废弃。
# DOUBAO_SEED 那个可能要填：默认发模型名 doubao-seed-evolving，账号里也可能要换成
# 推理接入点 ep-xxxxxxxx；填错的表现是那一栏 404，别的几栏照跑。
ARK_MODEL_DEEPSEEK_PRO=
ARK_MODEL_DEEPSEEK_FLASH=
ARK_MODEL_DOUBAO_SEED=

# ── ALT 与 SYNTH：Bedrock 上的 Claude Opus 5 与 GPT-5.6 ──
#
# **一把 key 撑这两条链路**（同一个账号在同一个区域里的两个模型，只是出口方言不同），
# 所以它缺了是一次少两栏，判断板的主源同时落回 DeepSeek —— 剩下 DeepSeek / 豆包
# 那两栏照跑。这个容器里不填也跑得起来，只是那两栏不出现。
#
#   REGION  拼进域名的（bedrock-runtime.<region>.amazonaws.com），不是请求参数；
#           一处改，两个口一起走。不填走 us-east-2。
#   两个口各有自己的整条地址覆盖变量（BEDROCK_BASE_URL 是 GPT 那个兼容口，
#   BEDROCK_ANTHROPIC_BASE_URL 是 Claude 那个口，后者只到域名为止）—— 共用一个的话，
#   配一条带 /openai/v1 的网关地址会把 Claude 这一条一起打歪。
#   两个 MODEL_* 默认都是「推理配置」那种 id（us. 前缀）；基础模型 id 在这个账号上
#   直接发是 404 / 400。
BEDROCK_API_KEY=
BEDROCK_REGION=us-east-2
BEDROCK_BASE_URL=
BEDROCK_ANTHROPIC_BASE_URL=
BEDROCK_MODEL_GPT56=
BEDROCK_MODEL_OPUS5=

# ── 运行模式与假模型 ──
# TKOS_MODE 默认 live（真数据 + 真模型）；要演示内容包写 demo（王总那一场的原文，
# 预研深研全预置，一次模型都不叫）。
# MOCK=1 返回罐头答案不出网（上线必须留空，否则从外面看和真机一模一样
# —— /api/health 把 mode 和 modelMock 都报出来）。
TKOS_MODE=live
TKOS_MODEL_MOCK=

# ── 深研走哪条链 ──
# 默认走那条七步链（锚定主体 → 先验草稿 → 命题与检索计划 → 分维度取证 → 校验合并 →
# 分层成稿 → 出口对账）：这一项**留空就是走它**。写 0 才回到原来「四个模型各写一份」
# 那一套，而那一支留着只为拿同一个议题两边各跑一遍作对比 —— **不是回滚开关**，
# 八维覆盖表、四态标签、七项出口机检在那边没有对应位置。
# 只有恰好等于 0 才算关，别的值一律当开。
TKOS_DR_V2=

# ── 深研的交付形态 ──
# TKOS_DR_BLOCKS=1 时深研按区块交（模型直接吐 JSONL、逐块过校验器、被拒的单独返修、
# 几条链路之后多一步对账），报告页因此有版式；关着跑出来是原来那份纯文本。
# 留空 = 关。compose 里这一项默认 1。
TKOS_DR_BLOCKS=1

# ── GraphKnowledge（M7 只读本体服务）──
# AUTH 是 user:password。VERIFY_TLS=0 = 不校验证书、不防中间人（图服务现在是
# IP + 自签证书，只能先关）；换域名 + 正式证书之后删掉这一行。
TKOS_GRAPHKNOWLEDGE_BASE_URL=
TKOS_GRAPHKNOWLEDGE_AUTH=
TKOS_GRAPHKNOWLEDGE_VERIFY_TLS=0
TKOS_GRAPHKNOWLEDGE_VIEWER=PSN-01

# 回落：没配方舟时 PRO / FLASH 走 DeepSeek 官方直连。深研另外那几条（ALT / SYNTH /
# SEED / OX）没有这条回落 —— 回落到 deepseek 等于把「另一个家族」这件事悄悄取消掉；
# SEED 尤其不许（它和 PRO 名义上共用 ARK_API_KEY，回落之后那两栏是同一个模型）。
# 此时交叉校验降级。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MODEL_PRO=deepseek-v4-pro

# ── 演示访问口令（src/proxy.ts + src/lib/access.ts）──
#
# 两项都要有。**缺任何一项 = 谁都进不去** —— 那不是「密码错了」，是访问控制没配好，
# /access 会直接说明并且不显示输入框。
#
#   PASSWORD  大小写不敏感，前后空格会被 trim
#   SECRET    cookie 签名用的 HMAC 密钥：openssl rand -hex 32
#             换掉它 = 已登录的人全部掉线。这是预期行为。
#
# 服务器上跑 deploy/ecs/configure-demo-access.sh <密码>，它会自己生成 SECRET。
TKOS_ACCESS_PASSWORD=
TKOS_ACCESS_SECRET=

# ── 机器口令（operator）──
# 两个用处：秘书控制台（本版封存），以及**抓取作业的收件口** POST /api/signals/inbox。
# 抓取作业那边把同一个值配成 TKOS_INBOX_TOKEN（见 tkos-lab 的 deploy/VERCEL.md）。
# 缺了收件口一律 503，配歪了 401 —— 两种都在日志里带 [tkos:inbox] 前缀。
OPERATOR_TOKEN=

# ── 对象库落盘 ──
# TKOS_PERSIST=0        每次重启回到种子状态
# TKOS_FAKE_LATENCY=1   读操作加回 200-600ms 假延迟
TKOS_PERSIST=1
TKOS_FAKE_LATENCY=0
# 上线设 1。不冻的话，谁动一下种子文件，下一次重启就把真实录入的议题、判断、决定
# 全部抹掉换回示例数据，日志里只有一行 warn。详见 docs/03_MVP上线与运维须知.md
TKOS_SEED_FROZEN=0

# ── 本体接入 ──
# TKOS_ONTOLOGY_CONTEXT=1 时，议题研究的对话与 A3 预研会把本体返回的企业
# Context 追加进 system prompt（追加，不替换前端自己算的那份）。
#
# 现在默认开：前端种子已经由 scripts/gen-seed-from-ontology.mjs 从本体数据集
# 直接生成，两边议题编号一一对应，resolve 能匹配上。种子若换回演示数据，
# 这里要改回 0，否则每次调用都是 no_match，白付一次往返。
#
# 本体不可用 / 没匹配上 / 超时，都只记日志不影响回复 —— 一号位不会因为
# 后台某个服务不在而对不了话。A3 预研在没有上下文时会主动在 openQuestion
# 里写明「本轮没拿到本体上下文」，而不是照常写得很笃定。
TKOS_ONTOLOGY_CONTEXT=1
TKOS_ONTOLOGY_TIMEOUT_MS=25000
TKOS_ENTERPRISE_ID=tokenking

# ── 深研的外部检索（src/lib/research/search.ts）──
#
# 这一段**在这个容器里跑**（不像信号扫描那边要靠实验台），所以这里不填，容器里的深研
# 就一轮都不联网 —— 而它不报错：报告会照实写「本轮未联网核验」，从目录上看跟联网跑出来
# 的那份一样。/api/health 的 upstream.search 就是为了从外面答这个问题。
#
#   PROVIDER  none / bocha / doubao，**可以填一串**：`bocha,doubao` = 一轮里同时用两家，
#             同一页只算一条来源（先列的那家留着，顺序就是优先级）。
#   *_KEY     一家一把。跟实验台那边是同一个账号的话，额度和 5 次每秒是账号维度共享的：
#             定时扫描和深研撞在一起时豆包会回超频错，那个错会带着家名进 trace，不会
#             静默变成「这题查不到」。
TKOS_SEARCH_PROVIDER=none
TKOS_SEARCH_BOCHA_KEY=
TKOS_SEARCH_DOUBAO_KEY=
