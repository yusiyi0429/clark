# TKOS 前端运行时环境变量。全部服务端读取（无 NEXT_PUBLIC_ 前缀），
# 容器运行时注入即可，不需要 build-time。

# ── 模型槽位（按角色配，不按厂商配；定义见 src/lib/models/{registry,slots}.ts）──
#
# 五个槽位、两把 key。火山方舟本身是多模型网关，DeepSeek 那两个和豆包一个 key 全能
# 拿到；另外两个槽位在 Bedrock 上，也共用一把（各有一段在下面）。
#
#   PRO    主对话与高质量生成（A6 回复、A2 定题、A4 深研、A10 写回）
#   FLASH  高频轻任务（A1a 产卡、关系标注这类三选一分类）
#   ALT    深研第二条链路（屏幕上那一栏叫「Claude」），也用于交叉 judge
#   SYNTH  深研第三条链路，也是判断板的主源（屏幕上叫「ChatGPT」，见下面 WANGSU_*）
#   SEED   深研第四条链路（屏幕上叫「豆包」）。**走方舟，和 PRO 同一把 key** —— 所以
#          这一栏不用配任何新变量，ARK_API_KEY 已经在跑的机器上它就在跑
#
# ★ 深研那几条链路必须**互不同模型家族**（深研那四条现在是四个家族）。理由不是「要用不同
#   厂商」，是自己判自己会通过自己的失败模式 —— 退化成同家族时校验等于没做，而通过率反而
#   更好看。几条同家族的话，那几份报告会一起漏掉同一个来源，而屏幕上仍然摆着几栏，看起来
#   像是互相印证过。配错了服务启动会在日志里告警（只告警不阻断）。
#
# 方舟这边只剩模型广场一个出口（ARK_API_KEY + /api/v3），带 pro / flash / seed 三个槽位。
# 套餐那个出口（ARK_AGENT_API_KEY + /api/plan/v3）2026-08-25 起没有模型走它了，两个变量
# 一起删掉：**配着却没有任何代码去读的 key 是个陷阱** —— 控制台里看着开通了，产品上一个
# 字都不经过它。
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 模型 id 覆盖。部署期才知道账号里开通的到底叫什么名字，所以留这道后门；
# 不填就用注册表里的默认值。（老名字 ARK_MODEL_PRO / _FLASH / _ALT 已废弃，
# 没有任何代码读它们。）
#
# DOUBAO_SEED 那个尤其可能要填：默认发的是模型名 doubao-seed-evolving，而账号里开通之后
# 也可能要换成推理接入点 ep-xxxxxxxx。填错的表现是那一栏 404（ModelNotOpen 或
# InvalidEndpointOrModel.NotFound），别的几栏照跑。
# ARK_MODEL_DEEPSEEK_PRO=
# ARK_MODEL_DEEPSEEK_FLASH=
# ARK_MODEL_DOUBAO_SEED=

# ── ALT 与 SYNTH：网宿 AI Gateway 上的 Claude Opus 5 与 GPT-5.6 ──
#
# 深研的第二、第三条链路：屏幕上那两栏叫「Claude」和「ChatGPT」。每条链路各跑一整套深研
# 框架 —— 各自编命题、各自联网取证、各自写报告、各自过出口对账，同时跑、同时显示、各自
# 计时。它们不是「同一套证据换个人写」，所以几份结论不一致时，那处不一致本身就是一条信息。
#
# ★ **一把 WANGSU_API_KEY 撑这两条。** 网宿是 OpenAI 兼容网关（`POST {base}/chat/completions`、
#   `Bearer` 认证、标准 `max_tokens`），两个家族走同一条口、同一把 key。所以这一把缺了是
#   **一次少两栏**，不是少一栏 —— 剩下 DeepSeek / 豆包 那两栏照跑。
#
# ★ **2026-09-01 从 AWS Bedrock 换过来。不是 key 的问题。** 生产在火山引擎的境内 IP 上，
#   Bedrock 的网络完全通（实测 TLS 0.78 秒握完、证书校验通过），但 Anthropic 与 OpenAI
#   在**模型层按来源国拒绝**：
#       400 Access to Anthropic models is not allowed from unsupported countries…
#       400 Access to OpenAI models is not allowed from unsupported countries…
#   换 key、换区域、换地址都不解决。那一天线上因此跑不出任何一份深研报告：七步链里
#   「先验草稿」和「分层成稿」两步整个压在 ALT 上，它一死，正文就是 0 块。
#
# ★ **判断板和四节压缩从 ChatGPT 那一条压出来。** 几条里它是主源：立案、写回、划词引用的
#   锚点都挂在它那一份上。它缺了主源顺位落到 DeepSeek 那一条 —— 屏幕上和这一轮的运行记录
#   里都写明换了谁。几条全跑不成这一轮才算挂。
#
# ★ **两笔明账**（换过来时丢掉的，不是遗漏）：
#   · **提示缓存没了。** `cache_control` 是 Anthropic 方言，OpenAI 兼容口没有对应字段。
#     8-27 加它是为了治「写四节每次整包重发同一份材料、一轮 alt 输入 349,472 token」。
#     实测网宿的用量里有 `cache_write_tokens` 这一格、而且同一前缀第二次快 8 倍 ——
#     上游像是在缓存，但计数器一直是 0，所以省没省钱**在账上看不见**。
#   · **流式没了。** 从前 Claude 那条走 Anthropic 原生口的流式（420 秒墙 + 空闲看门狗）；
#     现在是非流式，只有一道墙（见 `complete.ts` 的 `SLOW_CALL_TIMEOUT_MS`）。给兼容口
#     接上流式是欠账。
#
#   BASE_URL    整条地址覆盖，默认 https://api.edgecloudapp.com/v2/llm
#   MODEL_*     模型 id 覆盖。这把 key **只允许调它绑定的那份「模型配置」里的模型** ——
#               要加别的（比如 gpt-5.6-luna）得先去控制台改配置，否则是 400。
WANGSU_API_KEY=
# WANGSU_BASE_URL=
# WANGSU_MODEL_OPUS5=claude-opus-5
# WANGSU_MODEL_GPT56=gpt-5.6-sol

# 回落：没配方舟时 PRO / FLASH 走 DeepSeek 官方直连。深研另外那几条（ALT / SYNTH /
# SEED）**没有这条回落** —— 它们的全部意义是「另一个家族」，回落到 deepseek 等于把
# 这件事悄悄取消掉，而屏幕上仍然摆着那几栏。SEED 尤其不许回落：它和 PRO 名义上共用
# ARK_API_KEY，回落之后那两栏会是同一个模型在自己印证自己。
# 此时交叉校验会降级并在日志里告警。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MODEL_PRO=deepseek-v4-pro


# ── 运行模式与假模型 ──
#
# TKOS_MODE 默认 live：真数据 + 真模型。要看演示内容包写 TKOS_MODE=demo —— 那一档整套
# 内容是王总那一场的原文（时间停在 7 月 15 日，预研深研全预置，一次模型都不叫）。
# 默认给真数据是因为漏配的后果不是报错，是一号位对着为另一场准备的内容做判断，
# 而屏幕上没有一处说这是示例 —— /api/health 的 mode 字段就是为了从外面答这个问题。
# TKOS_MODEL_MOCK=1 时所有模型调用返回罐头答案，不出网 —— 用来在一把 key 都没配
# 的机器上把整条路跑通。**上线时必须是空的**：跑罐头的机器从外面看和真机一模一样
# （「怎么不花 token」会被查到别的地方去），所以 /api/health 会把它报出来。
TKOS_MODE=live
# TKOS_MODEL_MOCK=1

# ── 深研走哪条链 ──
#
# 深研默认走那条七步链：锚定主体 → 凭既有知识写先验草稿 → 抽命题排检索计划 → 分维度取证
# → 证据与草稿对账 → 分层成稿 → 出口对账。**这一行不填就是走它。**
# 写 TKOS_DR_V2=0 才回到原来那套「四个模型各写一份、挑一份上判断板」的做法，而留着那一支的
# 用处只剩一个：拿同一个议题两边各跑一遍作对比。**它不是回滚开关** —— 八维覆盖表、四态标签、
# 七项出口机检在那一支上没有对应的位置，关掉新链路等于这三样一起没有。
# 只有恰好等于 0 才算关：留空、写别的值一律当开（留空是「.env 里留了这一行没填值」，
# 那不该被读成「要走旧路」）。
# TKOS_DR_V2=0
#
# 七步链默认**不**再把 prompts/cognitive/a4.research.md 注进分节与收口（2026-09-04）：那份落法
# 是给 8/21 那版纯文本报告写的，它的篇幅（全文 1800–3500 字）、格式（只有 `## `）、四节压缩
# 与七步链的 system 段互相矛盾，且每节多喂 1 万 token。只有恰好等于 1 才注入，用于同题对比。
# TKOS_A4_COGNITIVE=1

# 深研的两个槽位开关，都是不填 = alt（claude-opus-5）、写 synth = gpt-5.6。
# · TKOS_A4_DRAFT_SLOT：先验草稿那一步。草稿定命题、命题定取证走哪条路，ISS-230 实测 gpt-5.6 的草稿
#   把命题押到抓不动的站上，入账从 44 掉到 4。建议留 alt。对账那一步自动取与草稿相反的那一家。
# · TKOS_A4_WRITER_SLOT：大纲、分节、收口暖场、返修。ISS-231 双轮对照：alt 在 12000 额度上五节全交、证据 19 条、
#   报告最好；synth 快 30%、字少一半、但两轮都是流程清单腔。默认留 alt；synth 是「要快不要深」那一档。
# TKOS_A4_DRAFT_SLOT=alt
# TKOS_A4_WRITER_SLOT=synth

# ── 本体叙述：回放一份冻结快照 ──
# 指向 contextSnapshots 里某次运行冻下来的 ctx-… id，这一步不打 memory-api，直接用那一次真取回的
# 原文。两个用途：上游躺了但这一轮必须带本体内容；同题对照时把公司上下文钉死（ISS-223 那份是
# ctx-c9e1e573b6eb78c6）。快照不存在就照旧打上游，trace 上会写「回放未命中」。跑完记得删掉。
# TKOS_ONTOLOGY_SNAPSHOT=ctx-c9e1e573b6eb78c6

# ── 深研的交付形态 ──
#
# TKOS_DR_BLOCKS=1 时深研按区块交：模型直接吐 JSONL，一块一条，出口逐块过校验器，被拒
# 的那一块单独返修；几条链路写完之后多一步跨链路对账，把分歧折成一处插回主源；报告页
# 因此有版式（关键数、算式、时间线、对照表、推翻条件卡…）而不是一长条散文。
# 关着的时候这条路径**一行都不走**，跑出来就是原来那份纯文本报告 —— 所以「怎么还是纯
# 文字」这个问题的答案九成是这一行没写。改了要重启 dev server（Next 只在起跑时读 .env）。
# 已经落库的区块报告不受这个开关影响：关掉它，那几份照旧有区块页签。
TKOS_DR_BLOCKS=1

# ── GraphKnowledge（M7 只读本体服务，src/lib/graphknowledge/）──
#
# 没配地址时请求压根发不出去，异常里会明说「地址是空的」—— 不要读成「服务挂了」。
# AUTH 必须是 user:password 形式（按第一个冒号切，密码里可以带冒号）；401/403 报的
# 是「拒绝认证」，跟「不可达」是两条排查路径。
#
# ★ VERIFY_TLS=0 的代价：这条链路不校验证书，**不防中间人**。现在图服务是 IP +
#   自签证书，所以只能先关。它露在 /api/health 的 upstream.graphknowledge.verifyTls
#   上，就是为了不让它变成一个没人记得的开关。换域名 + 正式证书之后**把它删掉**。
TKOS_GRAPHKNOWLEDGE_BASE_URL=
TKOS_GRAPHKNOWLEDGE_AUTH=
TKOS_GRAPHKNOWLEDGE_VERIFY_TLS=0
# 视角人（不填就是 PSN-01）。
# TKOS_GRAPHKNOWLEDGE_VIEWER=PSN-01

# ── 本体 Runtime API ──
#
# ★ 这两个变量**在 src/ 里没有任何一处读它们**（只有 scripts/tkos-probe.ps1 和
#   tkos-verify.ps1 用）。配着却没有代码去读的 key 是个陷阱 —— 控制台里看着开通了，
#   产品上一个字都不经过它。真正在跑的本体在下面那一段。
TKOS_ONTOLOGY_BASE_URL=http://115.190.213.44:8000
TKOS_API_KEY=

# ── 本体叙述接口（memory-api）：深研 / 预研 / 对话的公司上下文都从这儿来 ──
#
# 一个端点：`POST {BASE_URL}/v1/context-graph/narrative`，入参一句话，回一段从公司愿景
# 出发、沿主导航路径讲到相关节点的**叙述文**。上游自己做检索和装配，前端只发那一句话。
#
# ★ **本体分两层，这个端点只给其中一层。**
#     · 语义记忆 —— 跟公司有关的内容：愿景、本期 Outcome、八个 Domain、各条 Mission、
#       经营原则。**这个端点回的就是它**，外加一句「你问的这件事挂在其中哪一条下面」。
#     · 工作记忆 —— 存进本体的议题，以及它挂着的判断与共识。**本体还没建到这一层**，
#       所以这一路一条都取不到。
#   这不是配置问题，是当前的进度。它的后果落在三处：定题不再能「取代某条既有议题」
#   （没有既有议题可看）；报告里写不出「这条议题以前形成过哪些判断」；对谈里问
#   「我们之前对 X 下过什么判断」调这个工具是白花一次预算。
#   工作记忆进来那天，这三处连同 prompt 里那几段话要一起改 ——
#   `src/lib/ontology/narrative.live.test.ts` 里有一条用例会先红。
#
# ★ **每一条战略议题都从属于某一条当前的 Mission。** 所以这一路真正的产出不是
#   「公司记过这件事没有」，是「这件事挂在哪条 Mission 下」—— 挂不上本身也是一条结论
#   （要么这条议题不在当前战略路径上，要么当前这组 Mission 没覆盖它）。
#
# ★ **缺任何一项 = 深研 / 预研 / 定题 / 写回四条链路开局就地失败**，不是降级。那是有意的：
#   一份少了公司上下文的研究报告和完整的长得一模一样，静默降级没人查得出来。
#   对话那条不失败（少一段上下文，一号位当场感觉得到）。/api/health 的
#   `upstream.ontology.configured` 就是为了从外面答「这台机器配齐了没有」。
#
# ★ 它和上面 GraphKnowledge 那一段是**两个源，同一扇门**。走哪一个由
#   TKOS_ONTOLOGY_SOURCE 定（见下）。两边都配着是正常的 —— 换源要能一行拨回去对比。
#
# ★ 这个源**没有可引用的短码**（返回里对象以名字出现，不是 ISS-D6 / 01-J2 这种编号）。
#   所以屏幕上的锚点点不开，A1a 的 cited_member_ids 白名单只剩「引用必须为空」这条硬约束。
#
# TENANT / ORG 留空就不发这两个字段，由服务端填它自己的默认（local / local-org）。
# 抄一份默认值在这里的代价是上游改了默认之后两边悄悄漂移。
TKOS_MEMORY_API_BASE_URL=https://memory-api.tokenkingos.com
TKOS_MEMORY_API_KEY=
# TKOS_MEMORY_API_TENANT=
# TKOS_MEMORY_API_ORG=

# ── 本体走哪个源 ──
#
# 不填 = narrative（上面那个叙述接口）。**只有恰好写 graph 才切回 GraphKnowledge M7**
# 那条老路（同 TKOS_DR_V2 的口径：留空是「留了这一行没填值」，不该被读成「要走旧路」）。
#
# 它**不是回滚开关**：两支产出的材料形状不同（旧的有可引短码、有锚点相关性自检、有
# S01/S02/S03 三种厚度，新的都没有），拨过去不是「回到上一版」，是换了一种材料。
# 留着它的用处只有一个 —— 同一个议题两边各跑一遍作对比。
# TKOS_ONTOLOGY_SOURCE=graph

# ── 本体接入 ──
# TKOS_ONTOLOGY_CONTEXT=1 时，议题研究的对话与 A3 预研会把本体返回的企业
# Context 追加进 system prompt（追加，不替换前端自己算的那份）。
#
# 现在默认开：前端种子已经由 scripts/gen-seed-from-ontology.mjs 从本体数据集
# 直接生成，两边议题编号一一对应，resolve 能匹配上。种子若换回演示数据，
# 这里要改回 0，否则每次调用都是 no_match，白付一次往返。
#
# 本体不可用 / 没匹配上 / 超时，都只记日志不影响回复 —— 一号位不会因为
# 后台某个服务不在而对不了话。A3 预研在没有上下文时会主动在 openQuestion
# 里写明「本轮没拿到本体上下文」，而不是照常写得很笃定。
TKOS_ONTOLOGY_CONTEXT=1
# 一次本体调用的上限，两个源共用。叙述接口自己要跑一遍图检索再过一遍模型做压缩。
# 2026-09-03 实测十二次：最快 5.2 秒、最慢 32.9 秒，十二次里三次越过原来那道 25 秒的闸 ——
# 所以这个值现在是 45 秒。往下调之前先量一遍上游此刻的尾巴，卡到的会是正常调用。
# （对话那条路另有两道更窄的闸，见 src/lib/agent/company-context.ts。）
TKOS_ONTOLOGY_TIMEOUT_MS=45000
TKOS_ENTERPRISE_ID=tokenking

# ── 对象库落盘（lib/data/persist.ts）──
# TKOS_PERSIST=0        不落盘，每次重启回到种子状态
# TKOS_FAKE_LATENCY=1   读操作加回 200-600ms 假延迟（搬到服务端后真实 HTTP
#                       已自带往返，默认关；只在单独演示「正在加载」时开）
TKOS_PERSIST=1
TKOS_FAKE_LATENCY=0

# 快照落盘位置。容器里由 Dockerfile 设成 /app/.data 并挂卷；本机不设就用 .data/。
# TKOS_DATA_DIR=

# ★ 上线必须设 1。种子文件的指纹跟快照对不上时，默认规则是丢弃快照从种子重建
#   —— 开发期正确（改了种子却看不到变化会排查很久），上线之后反过来杀人：谁动一下
#   种子文件（改个示例文案都算），下一次重启就把一号位真正录进去的议题、判断、决定
#   全部抹掉换回示例数据，而日志里只有一行 warn。
#
#   冻结之后种子改动不生效，/api/health 的 seed.drift 会变成 true（意思是「你那次
#   改动没进去」）。真要换种子：先把 .data/store.json 挪走，再放开这个开关。
#   TKOS_KEEP_SNAPSHOT=1 不是它的替代品，那是开发期「这一次先别重建」的临时开关。
#
#   上线必须冻。这份 .env.example 和 docker-compose.yml 两处默认值反了等于把闸门废一半。
TKOS_SEED_FROZEN=1
# TKOS_KEEP_SNAPSHOT=1

# ── 演示访问口令（src/proxy.ts + src/lib/access.ts）──
#
# 两项都要有。**缺任何一项 = 谁都进不去** —— 那不是「密码错了」，是访问控制没配好，
# /access 会直接说明并且不显示输入框（对着一个永远不会成功的输入框反复试密码，
# 是产品自己制造的排查成本）。
#
#   PASSWORD  大小写不敏感（比对前两边都转小写），前后空格会被 trim
#   SECRET    给 cookie 签名的 HMAC 密钥，随便一串够长的随机值：
#               openssl rand -hex 32
#             换掉它 = 已登录的人全部掉线（cookie 签名对不上）。这是预期行为，
#             也是「踢掉所有人」唯一的办法。
#             也用来签 DRI 的一人一条链接（src/lib/identity.ts）。轮换它会同时踢掉一号位的
#             访问 cookie 和所有 DRI 链接 —— 那是当前唯一的撤销手段（spec §4.1）。
#
# 服务器上不要手填，跑 deploy/ecs/configure-demo-access.sh <密码>（它会自己生成 SECRET）。
TKOS_ACCESS_PASSWORD=
TKOS_ACCESS_SECRET=

# ── 机器口令（operator）──
# 两个用处：秘书控制台（本版封存），以及**抓取作业的收件口** POST /api/signals/inbox。
# 抓取作业那边把同一个值配成 TKOS_INBOX_TOKEN（见 tkos-lab 的 deploy/VERCEL.md）。
# 缺了收件口一律 503，配歪了 401 —— 两种都在日志里带 [tkos:inbox] 前缀。
OPERATOR_TOKEN=

# ── 「主动开始扫描」──
# 这个键**不需要任何变量**：整轮扫描在这个仓库里跑（src/lib/scan/run.ts），靶点策略和
# 那几个数签在 src/lib/scan/strategy-body.ts 里。它要的东西上面都配过了 ——
# 检索走 TKOS_SEARCH_PROVIDER 那几家，研判走 flash 那个槽位。
#
# 一家检索都用不上时那一轮直接失败，屏幕上写清是哪个变量没配 —— 不会假装在扫。
#
# 它原来是去实验台（tkos-lab，另一台本机 python 服务）起一轮 catching，靠
# TKOS_LAB_BASE_URL / _PASSWORD / _FROM_RUN / _AUTOSTART / _DIR / _PYTHON 六个变量。
# 那条路和那六个变量都删了：那台服务没起着的时候这个键就按不动，而扫不扫得成跟它
# 起没起着没有关系。

# ── 深研的外部检索（src/lib/research/search.ts）──
#
# 这是**深度研究自己的取证链路**，跟上面那个扫描不是一件事：那边是替他找信号，
# 这边是替一份已经在写的报告去核事实。选家 → 抓页 → 逐字定位引句 → 入账 → 独立性折叠
# → 覆盖判定，全在这个仓里（`src/lib/research/`）。两条路共用下面这几家检索。
#
#   PROVIDER  none（默认）/ bocha / doubao。填 none 或留空 = 本轮不联网。
#             **可以填一串**：`bocha,doubao` = 一轮里同时用这两家，每条检索式都发给
#             每一家，同一页只算一条（先列的那家留着，所以顺序就是优先级）。
#   *_KEY     跟着 PROVIDER 走，一家一把。TKOS_SEARCH_API_KEY 是单家时代的通用名，
#             作为回落还认，新配置不要用它。
#
# ★ 多一家的价值不在多几条结果，在于各家索引和排序不一样：一家漏掉的页另一家可能排在
#   第一条。但这句话本身不构成交叉验证 —— 两家搜到的是同一批页，那只是把同一份材料收了
#   两遍。所以每家各出了几条会分开记（返回几条 / 其中几条是别家没给的），完成事件里
#   直接写出来：`unique` 一直很低的那一家，换掉它比再加一家有用。
#
# ★ 这几把 key 要**配在这个仓自己的 .env.local 里**，不会从实验台那边继承 —— 两边是
#   两个进程，各读自己的环境。实验台那边也配着同名的两家，那不是重复配置的洁癖问题：
#   同一个账号下的额度和「5 次每秒」是**账号维度**共享的，定时扫描和深研撞在一起时
#   豆包会回超频错。那个错会带着家名进 trace，所以看得见，不会静默变成「这题查不到」。
#   正式版可以各签一把独立 key（账单上分得清是哪一边在烧、撤一把不牵连另一边），
#   但 QPS 仍然分不开 —— 那要两个账号。
#
# ★ 一家挂掉（限流、额度用尽）只影响那一家，别家照常出结果，原话带家名进 trace。
#   一串里有一家配坏了也是这样：能用的照跑，用不上的那几家单独写出来 —— 「配了三家
#   其实只有一家在跑」和「本来只配了一家」产出的报告长得一模一样。
#
# ★ 不配也跑得起来，而且**不是降级成假数据**：报告会照实写明「外部来源来自模型既有
#   知识，本轮未联网核验，落地引用前要先核一遍」，屏幕上那条完成事件也会写「这一轮
#   没有联网取证」。查不到是一个合法结果，编一个来源不是。
#   反过来也查：真取到了证据却写着「未联网」，质量门会判它自我否认（A4-R07）。
#
# ★ 填错家名（比如写了个没注册的）不报错也不静默 —— 那一家会被跳过，「未知的检索
#   provider」这句话带进这次运行的 trace；一串里所有家都用不上时才整轮不联网。配了
#   PROVIDER 却漏了 key 同理，trace 里会写明缺的是哪个变量名（**不写 key 本身，
#   也不写它的长度**）。
TKOS_SEARCH_PROVIDER=none
TKOS_SEARCH_BOCHA_KEY=
TKOS_SEARCH_DOUBAO_KEY=

# ── 深研开跑前先去通义拿一面 url（N2′）──
#
# 主体锚定完就发一次通义深研（qwen-deep-research），**只要它踩过的那些地址，不要它写的
# 报告**：报告里的断言没有台账、没有跨度定位、没有独立性折叠，进不了账本；而它自己会拆
# 子问题、搜好几轮，那面 url 比我们几条检索式够得着的宽。拿到地址就断流，它那一段最慢最
# 贵的写报告根本不跑。
#
# ★ 它跑在「写先验草稿」和「排检索计划」这两步底下（那两步一共 465 秒），所以**墙上时间
#   净增接近零**。自己有 4 分钟的上限，到点拿手上已收的那几条收口。
#
# ★ 地址必须整条填：官方 endpoint 里嵌着 workspace id，每个账号不一样。形如
#   https://<WorkspaceId>.cn-beijing.maas.aliyuncs.com/api/v1/services/aigc/text-generation/generation
#
# ★ key 复用 DASHSCOPE_API_KEY（这台机器上听和播报用的是同一把）。要分开计费时才填
#   TKOS_QWEN_RESEARCH_KEY，它优先。
#
# ★ 不配就整步不跑，N3 照旧自己搜 —— 行为回到没有这一步的样子，报告文首那份缺口清单里
#   也不会多一句（「这台机器没配」是常态配置，不是这一轮出的事）。配了却挂了/超时了才记。
#
# ★ 反过来：只配这一条、不配上面那几家检索，深研照样跑得动 —— 那几条种子是可以直接抓的
#   地址，走的不是检索。那一轮的报告会写明「全部抓取目标都来自那一次深研」。
# TKOS_QWEN_RESEARCH_URL=
# TKOS_QWEN_RESEARCH_KEY=
# 恰好等于 0 才算关（同 TKOS_DR_V2 的口径）。
# TKOS_DR_SEED=0

# ── 会议录音 → 逐字稿（src/lib/recording/）──
#
# 这条链路和下面那条「语音链路」不是一件事：那条是会上的实时语音条（阿里 paraformer，
# 边说边认，**给不出说话人**）；这条是会后把一份录音变成带说话人和时间戳的逐字稿，
# 走火山的「大模型录音文件识别」。
#
# ★ 这条链路**缺一样就整条不通，而且不报错**：屏幕上照旧能上传、照旧显示「排队中」，
#   然后在后台某一步倒掉，要点进那一份才看得见原因。所以 /api/health 的 `recording`
#   把三件前提分开报（ffmpeg / tos / asr）—— 少了哪一件要走的路完全不同。
#
# ★ 本机还要装 ffmpeg：`winget install Gyan.FFmpeg`（Windows），装完**重开终端**。
#   容器里由 Dockerfile 装（apt ffmpeg）。检测不到时那一份录音在第一步就失败，
#   错误原话里写着这条命令 —— 不静默降级，因为转写没有「大概转一下」的版本。
#
# ── 火山对象存储 TOS ──
#
# 为什么绕一趟对象存储：火山那个识别接口**只接 URL，不接文件**，而这台机器没有公网
# 可达的地址。桶要建成**私有**的 —— 传上去的是战略会的原始录音，公共读等于把它摆在
# 公网上（key 是 recordings/REC-20260831-xxxxxx.mp3 这种可枚举的形状）。
# 私有桶 + 预签名地址：签给谁、签多久是我们说了算。
#
#   ENDPOINT  **不带协议前缀**，形如 tos-cn-beijing.volces.com。带了会拼成
#             https://https://…，而报出来的错是一句和地址无关的连接失败。
#             （代码里替你削了一道，但控制台上复制下来的那一串多半是带的。）
#   REGION    形如 cn-beijing。要和桶的地域一致，建桶之后**改不了**。
#   BUCKET    全局唯一，只能小写字母数字和中划线。建议带自己的前缀。
#   KEY/SECRET  火山账号级或 IAM 用户级的 AK/SK（访问控制 IAM → API 访问密钥）。
#             生产建议建一个 IAM 用户，只给它那个桶的 tos:PutObject + tos:GetObject。
#             SecretAccessKey **只在创建时显示一次**。
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
TOS_ENDPOINT=tos-cn-beijing.volces.com
TOS_REGION=cn-beijing
TOS_BUCKET=

# ── 火山「大模型录音文件识别」标准版 ──
#
# ★ **两代控制台的凭据形状不一样，代码两种都认。** 配一种就行：
#     新版（豆包语音控制台 → API 管理）：只发一把 API Key → 配 VOLC_ASR_API_KEY
#     旧版（API 服务中心）：发的是 APP ID + Access Token 一对 →
#                          配 VOLC_ASR_APP_KEY（APP ID）和 VOLC_ASR_ACCESS_KEY（Access Token）
#   两种都留着是因为**开通那一步不在我们手里**：他在控制台上落到哪一版取决于账号
#   什么时候建的、点进了哪个入口，而「我按文档配好了却一直 401」是最难查的一类问题。
#
# ★ 模型要在控制台上**手动开通**，而且**认项目**（默认 Default）。没开通、或者在别的
#   项目下调用，接口直接报错。免费试用额度也要手动去点「试用」（20 小时，半年有效）。
#
# ★ RESOURCE_ID 不填就是豆包录音文件识别 2.0（volc.seedasr.auc，0.8 元/小时）。
#   只开通了 1.0 的话填 volc.bigasr.auc（2.3 元/小时）—— 发错的表现是被拒，而那个
#   拒绝看起来像鉴权错。提交和查询用的是同一个值，所以代码里只有这一处。
VOLC_ASR_API_KEY=
# VOLC_ASR_APP_KEY=
# VOLC_ASR_ACCESS_KEY=
# VOLC_ASR_RESOURCE_ID=volc.seedasr.auc

# ffmpeg / ffprobe 不在 PATH 上时指到它们（装在别处、或者 PATH 还没刷新）。
# 每次调用现读，所以装完不用重启 dev server。
# TKOS_FFMPEG_PATH=
# TKOS_FFPROBE_PATH=

# ── 阿里云百炼 DashScope：一把 key 撑三件事 ──
#
# 听（asr/paraformer.ts）、播报（tts/cosyvoice.ts）、深研开跑前那面 url
# （research/qwen-research.ts）读的是同一位。选 paraformer 的理由就是这个：会前只配
# 这一把，三层一起活。
#
# 空着的表现各不相同，都不是崩：听不见（语音条那个输入框还能用）、播报出不了声
# （预合成的音频还能放）、深研那一步整步不跑（N3 照旧自己搜）。
#
# 下面三处是它的**回落位**，只在要分开计费/分开限流时才填，填了的优先：
#   ASR_API_KEY（听）、TTS_API_KEY（播报）、TKOS_QWEN_RESEARCH_KEY（深研）。
DASHSCOPE_API_KEY=

# ── 语音链路（本版不部署，留空即降级）──
ASR_API_KEY=
ASR_ENDPOINT=
ASR_MODEL=
TTS_PROVIDER=
TTS_API_KEY=
TTS_ENDPOINT=
TTS_MODEL=
TTS_VOICE=
TTS_SPEED=
MINIMAX_GROUP_ID=

# ── 版本指纹 ──
TKOS_CODE_SHA=dev
